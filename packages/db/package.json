{
  "name": "@jfa/db",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/migrate-cli.ts --format esm,cjs --dts --clean --shims",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "@jfa/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.5.0"
  }
}
