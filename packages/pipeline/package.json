{
  "name": "@jfa/pipeline",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --shims",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "eval:live": "tsx scripts/live-eval.ts"
  },
  "dependencies": {
    "@jfa/core": "workspace:*",
    "@jfa/shared": "workspace:*",
    "puppeteer-core": "^24.43.0",
    "unpdf": "^1.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
