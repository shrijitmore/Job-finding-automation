# ---------- Shared (api + worker) ----------
# Postgres (Neon or Supabase). Append ?sslmode=require for hosted databases.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jfa
# 32+ random characters. Encrypts OAuth tokens and API keys at rest. Never change it after storing secrets.
ENCRYPTION_KEY=change-me-to-a-long-random-string
# Fallback Claude key. A key saved in Settings takes precedence.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Object storage for PDFs and screenshots (Cloudflare R2 or any S3-compatible store).
# Leave empty to store files on local disk under LOCAL_STORAGE_DIR.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=./storage-local

# ---------- API ----------
PORT=4000
JWT_SECRET=change-me-too
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
# Seeds the owner account at startup. Otherwise the first visitor creates it (set ALLOW_SETUP=false after).
OWNER_EMAIL=
OWNER_PASSWORD=
ALLOW_SETUP=true
# Google OAuth client for Gmail (see README). Also set these on the worker.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Serve the built web app from the API (one origin). Example: ../web/dist
WEB_DIST_DIR=
# Login attempts per minute per IP
AUTH_RATE_LIMIT=10
# Use deterministic fake Claude responses (demos and tests)
LLM_FAKE=

# ---------- Worker ----------
WEB_PUBLIC_URL=http://localhost:5173
# Optional path to a Chromium binary for Puppeteer PDF rendering
CHROMIUM_PATH=
SCRAPE_MIN_DELAY_MS=2000
SCRAPE_MAX_DELAY_MS=5000
# Random pause between real submissions
APPLY_MIN_DELAY_MS=20000
APPLY_MAX_DELAY_MS=90000
# Fill Greenhouse, Lever and Ashby forms (false = manual apply)
ATS_FORMS_ENABLED=true
# Upper bound on jobs scored per run
MAX_SCORE_PER_RUN=40
# The API runs migrations; set false on the worker if both start together
MIGRATE_ON_START=true

# ---------- Web (build time) ----------
# Leave empty when the web app is served behind the same origin as the API or uses the dev proxy.
VITE_API_URL=
